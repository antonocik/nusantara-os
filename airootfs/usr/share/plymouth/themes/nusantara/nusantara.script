# Nusantara OS Plymouth Script Theme — Merah Putih
# Background charcoal + merah, logo tengah, progress bar merah

Window.SetBackgroundTopColor (0.043, 0.055, 0.078);
Window.SetBackgroundBottomColor (0.118, 0.039, 0.071);

# State
global.status_duration = 15;
global.progress_duration = 100;
global.rotation_duration = 30.0;
global.message_duration = 10.0;
global.progress = 0.0;
global.logo = null;
global.progress_bar = null;
global.spinner = null;
global.message = null;

fun draw_background (x, y, width, height) {
  # background sudah di-set via SetBackground*
  # tambah vignette halus via overlay rectangle
  local red = 0.225; local green = 0.114; local blue = 0.282;
  local r = 0.882; local g = 0.114; local b = 0.282;
  # logo
  if (global.logo) {
    global.logo.position.x = x + (width - global.logo.width) / 2;
    global.logo.position.y = y + height * 0.22;
  }
  # progress bar
  if (global.progress_bar) {
    global.progress_bar.position.x = x + (width - 420) / 2;
    global.progress_bar.position.y = y + height * 0.72;
  }
  # message
  if (global.message) {
    global.message.position.x = x + (width - global.message.width) / 2;
    global.message.position.y = y + height * 0.80;
  }
}

fun draw_progress (duration, progress) {
  global.progress = progress;
  if (global.progress_bar) {
    # update progress dengan cara redrawing scale
    # plymouth script: gunakan Math.Progress
    # (draw_background dipanggil ulang tiap frame)
    global.progress_bar.position.x = global.progress_bar.position.x;
  }
}

fun startup (duration, progress) {
  if (!global.logo) {
    global.logo = Sprite();
    global.logo.image = Image("/usr/share/plymouth/themes/nusantara/logo.png");
    global.logo.opacity = 1.0;
  }
  # fallback Text jika logo.png tidak ada
  if (!global.message) {
    global.message = Sprite();
    global.message.image = Image.Text("NUSANTARA OS  •  Merdeka", 36, 1, 0.97, 0.98, 0.98);
    global.message.opacity = 0.9;
  }
}

fun boot (duration, progress) { startup(duration, progress); draw_progress(duration, progress); }
fun shutdown (duration, progress) { startup(duration, progress); draw_progress(duration, progress); }

Window.Hook ("boot", boot);
Window.Hook ("shutdown", shutdown);
