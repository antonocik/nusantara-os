#!/usr/bin/env bash
# Nusantara Update — padanan garuda-update
# Snapshot -> mirror -> pacman -Syu -> AUR -> bersihkan cache
set -uo pipefail

RED=$'\e[31m'; GREEN=$'\e[32m'; RESET=$'\e[0m'
SUDO=""
[[ $EUID -ne 0 ]] && SUDO="sudo"
have() { command -v "$1" >/dev/null 2>&1; }

echo -e "${GREEN}=== Nusantara OS Update ===${RESET}"

echo "1) Snapshot sistem..."
if have timeshift; then
  $SUDO timeshift --create --comments "Sebelum update $(date -Is)" || \
    echo "Timeshift dilewati (bukan BTRFS / bukan root)."
elif have snapper; then
  $SUDO snapper -c root create -d "Sebelum update $(date -Is)" || true
else
  echo "timeshift/snapper tidak ada, dilewati."
fi

echo "2) Update mirrorlist..."
if have reflector; then
  $SUDO reflector --country Indonesia,Singapore,Japan,United\ States,Germany \
    --protocol https --latest 20 --sort rate \
    --save /etc/pacman.d/mirrorlist || echo "reflector gagal, mirror tidak diubah."
else
  echo "reflector tidak ada, dilewati."
fi

echo "3) Pacman full update..."
$SUDO pacman -Syu || { echo -e "${RED}Update gagal.${RESET}"; exit 1; }

echo "4) Paket AUR (bila ada helper)..."
if have pamac; then $SUDO pamac update -a
elif have paru; then paru -Sua --noconfirm
elif have yay; then yay -Sua --noconfirm
else echo "Tidak ada paru/yay/pamac, dilewati."; fi

echo "5) Bersihkan cache paket lama..."
have paccache && $SUDO paccache -rk3

echo
echo -e "${GREEN}Selesai.${RESET} Reboot bila ada update kernel/glibc/systemd."
